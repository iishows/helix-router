+/**
+ * Helix recall accounting: for each internal tool result produced this turn,
+ * add its injected-content character length under the call name. The result
+ * content is already a string (stringifyVirtualToolOutput); successful recall
+ * results carry the original Q&A / block text that replaced a ⟦QA:⟧ placeholder.
+ * Errors are excluded so a not_found never inflates the recall total.
+ */
+function recordInternalToolInjectionChars(
+  target: Record<string, number>,
+  calls: StandardResponseFunctionCall[],
+  results: StandardRequestInputContent[]
+): void {
+  const nameByCallId = new Map<string, string>();
+  for (const call of calls) {
+    nameByCallId.set(call.call_id, call.name);
+  }
+  for (const result of results) {
+    if (!isObject(result)) {
+      continue;
+    }
+    const record = result as Record<string, unknown>;
+    const toolUseId = typeof record.tool_use_id === 'string' ? record.tool_use_id : '';
+    const name = nameByCallId.get(toolUseId) || '';
+    if (!name || record.is_error === true) {
+      continue;
+    }
+    const content = record.content;
+    const length = typeof content === 'string' ? content.length : 0;
+    if (length <= 0) {
+      continue;
+    }
+    target[name] = (target[name] ?? 0) + length;
+  }
+}
