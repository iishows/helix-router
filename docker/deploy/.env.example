# CCR 服务器部署环境变量示例。
#
# 用法：复制为 .env 并填好，然后 chmod 600 .env。
#   install.sh 会自动生成这份文件；只有手工部署时才需要自己复制。
#
# 注意：.env 含管理凭据，不要提交到版本库、不要贴进工单或截图。

# 客户端应当使用的完整公开地址（含协议，不带结尾斜杠）。
# 它会被写进 CCR 的公开路由端点。改了域名或端口就要同步改这里。
CCR_PUBLIC_BASE_URL=https://ccr.example.com

# Web 管理台登录密码（凭据）。浏览器访问管理台时输入它换会话 cookie。
# 生成：openssl rand -base64 24
# 留空则容器首次启动时自动生成随机密码，并持久化到数据卷
# .claude-code-router/web-login-password，同时打进容器日志（docker logs ccr）。
CCR_WEB_LOGIN_PASSWORD=请替换为随机串

# 管理 token：仅用于非浏览器调用（脚本/反代注入），不会被下发给浏览器。
# 除非你要在反代里注入 x-ccr-web-auth，否则保持默认（容器自动随机生成）。
CCR_WEB_AUTH_TOKEN=

# 管理 token 是否走 URL：
#   0 = 默认。浏览器一律走上面的密码登录，token 不进入 URL。
#   1 = 加固。由宿主反代以请求头 x-ccr-web-auth 注入，容器内不再做密码登录。
#       开启前必须先在该反代前加分一层访问限制（Basic / oauth2-proxy / VPN），
#       否则任何能访问该站点的人都等于管理员。
CCR_WEB_INJECT_HEADER=0

# ---- 以下不是 .env 内容，而是执行 install.sh 时可用的环境变量 ----
#
# 升级守卫：容器已存在、但当前目录缺 .env 时，install.sh 会拒绝执行，
# 以免生成新 token 把旧 token 和反代注入值一起弄失效。
# 确认就是要轮换 token（例如疑似泄露）时，放行：
#   CCR_ALLOW_NEW_TOKEN=1 sh install.sh
#
# 首次安装时指定公开地址（省得装完再改）：
#   CCR_PUBLIC_BASE_URL=https://ccr.example.com sh install.sh
